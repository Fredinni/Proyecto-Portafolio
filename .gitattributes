# Preserve POSIX entrypoints on Windows checkouts.
src/pfsense_setup/*.sh text eol=lf
*.py text eol=lf
*.sh text eol=lf
Dockerfile* text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.service text eol=lf
*.rc text eol=lf
*.rules text eol=lf
*.php text eol=lf
*.conf text eol=lf
*.md text eol=lf
*.xml text eol=lf
# Office and PDF exports must preserve exact bytes, including xref offsets.
*.pdf binary
*.docx binary
*.pptx binary
# Keep the uploaded audiovisual transcript byte-for-byte.
*.vtt -text
