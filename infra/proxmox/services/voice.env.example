# Copy to /etc/kronos/voice.env, mode 0600. Supply real values outside Git.
GEMINI_API_KEY_FILE=/etc/kronos/voice/gemini.key
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Aoede
KRONOS_VOICE_CONFIG=/etc/kronos/voice/config.json
KRONOS_CALL_DIR=/run/kronos/calls
KRONOS_CALL_CHANNEL=PJSIP/1004
KRONOS_DISPATCH_BIND=192.168.30.50
KRONOS_DISPATCH_PORT=8080
KRONOS_CALL_COOLDOWN_SECONDS=120
KRONOS_GLOBAL_CALL_COOLDOWN_SECONDS=120
KRONOS_DISPATCH_TOKEN=
ASTERISK_AMI_HOST=127.0.0.1
ASTERISK_AMI_USER=kronos_ami
ASTERISK_AMI_SECRET=
