drop http any any -> 192.168.20.50 80 (msg:"KRONOS command injection body"; flow:established,to_server; http.request_body; pcre:"/(?:\x3b|%3b|\x7c|%7c|&&|%26%26)(?:\s|%20|\+)*(?:whoami|id|cat|wget|curl|bash|sh|nc)\b/i"; classtype:web-application-attack; sid:1000015; rev:1;)
