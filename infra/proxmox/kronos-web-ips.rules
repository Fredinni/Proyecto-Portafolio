# Target is the isolated DVWA backend after HAProxy TLS termination.
drop http any any -> 192.168.20.50 80 (msg:"KRONOS SQL injection UNION SELECT URI"; flow:established,to_server; http.uri; content:"union"; nocase; fast_pattern; pcre:"/\bunion(?:\s|%20|\+)+(?:all(?:\s|%20|\+)+)?select\b/i"; classtype:web-application-attack; sid:1000010; rev:1;)
